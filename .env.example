# Gmail account that sends enquiries (server-side only).
GMAIL_USER=hello@fairpointe.co.uk

# Gmail app password for GMAIL_USER (requires 2-Step Verification).
# https://myaccount.google.com/apppasswords
GMAIL_APP_PASSWORD=

# Optional sender override. Gmail only allows GMAIL_USER or a verified "Send mail as" alias.
# CONTACT_FROM_EMAIL="Fairpointe Website <hello@fairpointe.co.uk>"

# Optional override for the enquiry recipient. Defaults to hello@fairpointe.co.uk.
# CONTACT_TO_EMAIL=hello@fairpointe.co.uk
