# Resend API key (server-side only). https://resend.com/api-keys
RESEND_API_KEY=

# Sender address. The domain must be verified in Resend.
CONTACT_FROM_EMAIL="Fairpointe Website <website@fairpointe.co.uk>"

# Optional override for the enquiry recipient. Defaults to hello@fairpointe.co.uk.
# CONTACT_TO_EMAIL=hello@fairpointe.co.uk
